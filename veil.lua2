-- Sky Spinner логика
task.spawn(function()
    while task.wait(1) do
        if VEIL.SkyRoll then
            local hrp = getHRP()
            if not hrp then continue end
            local shop = nil
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj.Name:lower():find("fruit") and obj.Name:lower():find("dealer") then
                    shop = obj; break
                end
            end
            if shop then
                hrp.CFrame = CFrame.new(shop.Position + Vector3.new(0, 5, 0), shop.Position)
                task.wait(0.5)
                local prompt = shop:FindFirstChildOfClass("ProximityPrompt")
                if prompt then fireproximityprompt(prompt); task.wait(1) end
                for _, btn in pairs(LP.PlayerGui:GetDescendants()) do
                    if btn:IsA("TextButton") then
                        local t = btn.Text and btn.Text:lower() or ""
                        if t:find("random") or t:find("roll") or t:find("spin") then
                            btn:Activate()
                            task.wait(2)
                            notify("Spinner", "Roll выполнен", 2)
                            break
                        end
                    end
                end
            end
        end
    end
end)

-- Auto Buy Fruit логика
task.spawn(function()
    while task.wait(2) do
        if VEIL.AutoBuyFruit and VEIL.BuyFruitTarget then
            local target = VEIL.BuyFruitTarget:lower()
            for _, obj in pairs(LP.PlayerGui:GetDescendants()) do
                if obj:IsA("TextLabel") then
                    if obj.Text:lower():find(target) then
                        local parent = obj.Parent
                        for _, btn in pairs(parent:GetDescendants()) do
                            if btn:IsA("TextButton") and btn.Text:lower():find("buy") then
                                btn:Activate()
                                notify("Auto Buy", "Куплен: " .. VEIL.BuyFruitTarget, 3)
                            end
                        end
                    end
                end
            end
        end
    end
end)

