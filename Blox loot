-- PLAYER ESP
local PlayerESPObjects = {}
local function removePlayerESP(plr)
    if PlayerESPObjects[plr] then
        pcall(function() PlayerESPObjects[plr]:Destroy() end)
        PlayerESPObjects[plr] = nil
    end
end
local function applyPlayerESP(plr)
    if plr == LP then return end
    if not CFG.PlayerESP then return end
    if PlayerESPObjects[plr] then return end
    local char = plr.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    if not head or not hum then return end

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0,240,0,70)
    bb.StudsOffset = Vector3.new(0,3.5,0)
    bb.AlwaysOnTop = true
    bb.Adornee = head
    bb.Parent = head

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1,0,1,0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(0,255,100)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextStrokeTransparency = 0
    label.Parent = bb

    local function upd()
        if not label.Parent or not hum.Parent then return end
        local hp = math.floor(hum.Health)
        local maxHp = math.floor(hum.MaxHealth)
        local lvl, rb = 0, 0
        local stats = plr:FindFirstChild("leaderstats")
        if stats then
            for _, s in ipairs(stats:GetChildren()) do
                local n = s.Name:lower()
                if n == "level" or n == "lvl" then lvl = s.Value end
                if n == "rebirth" or n == "reb" then rb = s.Value end
            end
        end
        label.Text = string.format("%s\nHP: %d/%d\nLvl: %d | Rb: %d", plr.Name, hp, maxHp, lvl, rb)
    end
    upd()
    PlayerESPObjects[plr] = bb
    hum:GetPropertyChangedSignal("Health"):Connect(upd)
    plr.CharacterAdded:Connect(function()
        task.wait(1)
        removePlayerESP(plr)
        if CFG.PlayerESP then applyPlayerESP(plr) end
    end)
end
task.spawn(function()
    while task.wait(1) do
        if CFG.PlayerESP then
            for _, plr in ipairs(Players:GetPlayers()) do applyPlayerESP(plr) end
        else
            for plr, _ in pairs(PlayerESPObjects) do removePlayerESP(plr) end
        end
    end
end)

-- MOB ESP
local MobESPObjects = {}
local function removeMobESP(model)
    if MobESPObjects[model] then
        pcall(function() MobESPObjects[model]:Destroy() end)
        MobESPObjects[model] = nil
    end
end
local function createMobESP(model)
    if MobESPObjects[model] then return end
    if Players:GetPlayerFromCharacter(model) then return end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local head = model:FindFirstChild("Head") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not head then return end

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(4,0,1.6,0)
    bb.StudsOffset = Vector3.new(0,2.5,0)
    bb.AlwaysOnTop = true
    bb.Adornee = head
    bb.Parent = head

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1,0,1,0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255,255,255)
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 14
    label.TextStrokeTransparency = 0
    label.Parent = bb

    local function upd()
        if not label.Parent or not hum.Parent then return end
        local hp = math.floor(hum.Health)
        local maxHp = math.floor(hum.MaxHealth)
        local dist = 0
        local char = LP.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            dist = math.floor((char.HumanoidRootPart.Position - head.Position).Magnitude)
        end
        label.Text = string.format("%s\nHP: %d/%d | %dm", model.Name, hp, maxHp, dist)
    end
    upd()
    MobESPObjects[model] = bb
    hum:GetPropertyChangedSignal("Health"):Connect(function()
        if hum.Health <= 0 then removeMobESP(model) else upd() end
    end)
    task.spawn(function()
        while MobESPObjects[model] and CFG.MobESP do upd(); task.wait(0.3) end
    end)
    model.AncestryChanged:Connect(function(_, p)
        if not p then removeMobESP(model) end
    end)
end
task.spawn(function()
    while task.wait(2) do
        if CFG.MobESP then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                    createMobESP(obj)
                end
            end
        else
            for m, _ in pairs(MobESPObjects) do removeMobESP(m) end
        end
    end
end)

-- MAIN LOOP
local function findNearestMob()
    local char = LP.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local closest, dist = nil, math.huge
    for _, mob in ipairs(workspace:GetDescendants()) do
        if mob:IsA("Model") and mob:FindFirstChildOfClass("Humanoid") then
            if not Players:GetPlayerFromCharacter(mob) then
                local hum = mob:FindFirstChildOfClass("Humanoid")
                if hum.Health > 0 then
                    local mhrp = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Torso")
                    if mhrp then
                        local d = (mhrp.Position - hrp.Position).Magnitude
                        if d < dist then dist = d; closest = mob end
                    end
                end
            end
        end
    end
    return closest
end

local function matchLoot(name)
    if CFG.LootFilter == "All" then return true end
    return name:lower():find(CFG.LootFilter:lower(), 1, true) ~= nil
end

RunService.Heartbeat:Connect(function()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if CFG.GodMode then
        hum.MaxHealth = math.huge
        hum.Health = math.huge
    end
    if CFG.SpeedEnabled and hum.WalkSpeed ~= CFG.SpeedValue then
        hum.WalkSpeed = CFG.SpeedValue
    end
    if CFG.AttackEnabled then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            for _, v in ipairs(tool:GetDescendants()) do
                if v:IsA("NumberValue") then
                    local n = v.Name:lower()
                    if n:find("cool") or n:find("delay") or n:find("cd") then
                        pcall(function() v.Value = 0 end)
                    end
                end
            end
            pcall(function() tool:Activate() end)
        end
    end
    if CFG.FarmEnabled and hrp then
        local mob = findNearestMob()
        if mob then
            local mhrp = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Torso")
            if mhrp then
                if CFG.FarmMode == "TP" then
                    hrp.CFrame = mhrp.CFrame + Vector3.new(0,5,0)
                else
                    if (hrp.Position - mhrp.Position).Magnitude > 5 then
                        hum.WalkSpeed = CFG.FarmSpeed
                        hum:MoveTo(mhrp.Position)
                    end
                end
            end
        end
    end
    if CFG.AutoLoot and hrp then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and matchLoot(obj.Name) then
                local d = (obj.Position - hrp.Position).Magnitude
                if d < 30 and d > 3 then
                    hrp.CFrame = obj.CFrame + Vector3.new(0,3,0)
                end
            end
        end
    end
end)

